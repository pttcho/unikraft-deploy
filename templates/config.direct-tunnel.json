{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "direct-ws",
      "listen": "::",
      "listen_port": 8080,
      "users": [
        {
          "name": "default",
          "uuid": "YOUR_UUID"
        }
      ],
      "transport": {
        "type": "ws",
        "path": "/"
      }
    },
    {
      "type": "vless",
      "tag": "direct-httpupgrade",
      "listen": "::",
      "listen_port": 8081,
      "users": [
        {
          "name": "default",
          "uuid": "YOUR_UUID"
        }
      ],
      "transport": {
        "type": "httpupgrade",
        "host": "",
        "path": "/"
      }
    },
    {
      "type": "vless",
      "tag": "argo-ws",
      "listen": "::",
      "listen_port": 8090,
      "users": [
        {
          "name": "default",
          "uuid": "YOUR_UUID"
        }
      ],
      "transport": {
        "type": "ws",
        "path": "/"
      }
    },
    {
      "type": "cloudflared",
      "tag": "argo-tunnel",
      "token": "YOUR_TOKEN"
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": ["argo-tunnel"],
        "action": "route-options",
        "override_address": "127.0.0.1"
      }
    ]
  }
}